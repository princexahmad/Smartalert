# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=@YourBotUsername

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/price_tracker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=price_tracker
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Admin
ADMIN_IDS=123456789,987654321
ADMIN_USERNAMES=admin1,admin2

# Plans
FREE_PRODUCT_LIMIT=5
FREE_MONITOR_INTERVAL=30
PREMIUM_PRODUCT_LIMIT=100
PREMIUM_MONITOR_INTERVAL=10
PREMIUM_PRICE=499

# Monitor
MONITOR_INTERVAL_MINUTES=10
MONITOR_BATCH_SIZE=10
MONITOR_RETRY_ATTEMPTS=3
MONITOR_RETRY_DELAY_MS=5000

# Scraper
SCRAPER_TIMEOUT=30000
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SCRAPER_HEADLESS=true
SCRAPER_VIEWPORT_WIDTH=1280
SCRAPER_VIEWPORT_HEIGHT=720

# API
API_PORT=3000
API_HOST=0.0.0.0
API_KEY=your_api_key_here
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# App
NODE_ENV=production
LOG_LEVEL=info
TIMEZONE=Asia/Kolkata
MAX_PRODUCT_TITLE_LENGTH=200
PRICE_ALERT_THRESHOLD=0
