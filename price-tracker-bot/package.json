{
  "name": "price-tracker-bot",
  "version": "1.0.0",
  "description": "Telegram Product Price Tracker Bot - Track Amazon & Flipkart prices",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "api": "node api/server.js",
    "monitor": "node src/services/monitor.js",
    "migrate": "node src/database/migrate.js",
    "pm2": "pm2 start ecosystem.config.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test": "jest --coverage",
    "lint": "eslint src/",
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium"
  },
  "dependencies": {
    "@telegraf/types": "^7.1.0",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsdom": "^24.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "playwright": "^1.47.0",
    "telegraf": "^4.16.3",
    "uuid": "^10.0.0",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
